# Byte-compiled / Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Data directories - NEVER commit raw patient data or credentialed datasets
/data/
/data_raw/
/data_processed/
!src/data/
*.dcm
*.jpg
*.jpeg
*.png
!outputs/figures/*.png
!outputs/figures/*.svg
!outputs/figures/*.pdf

# Checkpoints and models - NEVER commit heavy binary weights trained on credentialed data
outputs/checkpoints/
*.pth
*.pt
*.bin
*.safetensors

# Logs and system outputs
logs/
wandb/
.pytest_cache/
.ipynb_checkpoints/
*.log

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
